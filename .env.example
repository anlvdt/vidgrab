# ─── VidGrab Environment Variables ───

# Site URL (used for sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://vidgrab.io.vn

# Proxy for yt-dlp (optional)
# YTDLP_PROXY=socks5://127.0.0.1:1080

# PO-token (Proof-of-Origin) provider for YouTube (optional but STRONGLY
# recommended for cloud/datacenter hosting — fixes most "Sign in to confirm
# you're not a bot" failures). Run the sidecar, then point yt-dlp at it:
#   docker run -d --name bgutil-pot -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider:1.2.2
#   pip install bgutil-ytdlp-pot-provider   # the yt-dlp plugin half
# BGUTIL_POT_BASE_URL=http://localhost:4416

# Cobalt API fallback (optional, self-hosted)
# docker run -p 9000:9000 ghcr.io/imputnet/cobalt
# COBALT_API_URL=http://localhost:9000
# COBALT_API_KEY=
