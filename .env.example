# ─── VidGrab Environment Variables ───

# Site URL (used for sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://vidgrab.io.vn

# AdSense account used for site verification and /ads.txt. This is public and
# defaults to VidGrab's account in src/lib/adsense.ts; set it here to override.
NEXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=ca-pub-2128076491386515

# Proxy for yt-dlp (optional)
# YTDLP_PROXY=socks5://127.0.0.1:1080

# JavaScript runtime used by yt-dlp-ejs for full YouTube challenge solving.
# Node ships with the app image. Set to deno:/path or bun:/path if preferred.
YTDLP_JS_RUNTIME=node

# Browser/TLS impersonation for generic extractor retries. Requires curl_cffi,
# which is bundled by scripts/deploy.sh. Use "off" to disable.
YTDLP_IMPERSONATE=chrome

# PO-token (Proof-of-Origin) provider for YouTube (optional but STRONGLY
# recommended for cloud/datacenter hosting — fixes most "Sign in to confirm
# you're not a bot" failures). Run the sidecar, then point yt-dlp at it:
#   docker run -d --name bgutil-pot -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider:1.2.2
#   pip install bgutil-ytdlp-pot-provider   # the yt-dlp plugin half
# BGUTIL_POT_BASE_URL=http://localhost:4416

# Cobalt API fallback (optional, self-hosted)
# docker run -p 9000:9000 ghcr.io/imputnet/cobalt
# COBALT_API_URL=http://localhost:9000
# COBALT_API_KEY=

# Trust reverse-proxy client IP headers for rate limiting only when your edge
# strips spoofed incoming forwarding headers.
# VIDGRAB_TRUST_PROXY_HEADERS=true

# Cookies file used by yt-dlp for platforms that require login.
# VIDGRAB_COOKIES_PATH=/app/cookies.txt
